# Copy to upstream.env and edit. Do not commit upstream.env.
#
# SHISHA: absolute path to the private monorepo root, or path relative to
#         the public mmr-light-client repo root.
# UPSTREAM_TYPES_ROOT: directory that holds the types subset mapped onto
#         crates/filament-types (relative to SHISHA, or absolute).

SHISHA=/absolute/path/to/private-monorepo
UPSTREAM_TYPES_ROOT=relative/or/absolute/path/to/types-subset
